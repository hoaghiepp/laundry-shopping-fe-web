# Port published on the host (container always listens on 8080)
PORT=8080

# Same-origin /v1 proxy — do not set localhost here when using Cloudflare Tunnel.
# EXPO_PUBLIC_API_BASE_URL=https://web.dhhcloud.io.vn

# Backend API origin for the /v1/* server proxy (no trailing slash).
EXPO_PUBLIC_API_PROXY_TARGET=https://test.dhhcloud.io.vn
